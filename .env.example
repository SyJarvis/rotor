# API Settings
API_V1_STR=/v1
PROJECT_NAME=Rotor
VERSION=1.0.0

# Security - Change in production!
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
API_KEY_PREFIX=sk-
# Database (SQLite default)
# Defaults to sqlite+aiosqlite:///~/.cache/rotor/rotor.db when unset.
# DATABASE_URL=sqlite+aiosqlite:////Users/you/.cache/rotor/rotor.db
# For PostgreSQL use:
# DATABASE_URL=postgresql+asyncpg://rotor:rotor@localhost:5432/rotor

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Request Settings
MAX_RETRIES=3
RETRY_DELAY=1.0
REQUEST_TIMEOUT=120.0

# Default Channel Settings
DEFAULT_CHANNEL_PRIORITY=1
DEFAULT_CHANNEL_WEIGHT=1

# Logging
LOG_REQUESTS=true
LOG_LEVEL=INFO

# Conversation storage
CONVERSATION_STORE_ENABLED=true
# Defaults to ~/.cache/rotor/conversations when unset.
# CONVERSATION_STORE_DIR=/Users/you/.cache/rotor/conversations
CONVERSATION_STORE_FORMAT=jsonl
SAVE_CONVERSATION_BODY=true
SAVE_PROVIDER_RESPONSE=true
CONVERSATION_RETENTION_DAYS=30
